    def test_mixed_workflow_optimization(self, mixed_workflow):
        """Test optimizer on workflow with both high and low fanout."""
        logger.info("Testing mixed fanout optimization")
        original_count = len(mixed_workflow.nodes)
        result = optimize(mixed_workflow)
        new_count = len(result.nodes)
        
        # In mixed_workflow, link 10 (MODEL) appears twice (to nodes 2, 3)
        # Due to JSON dict key uniqueness, only one survives (target=3).
        # The surviving link 10 goes from node 1 to node 3 with fanout=1 (node 3 -> link 50 -> node 0)
        # So it has fanout=1 and is NOT optimized.
        # Link 20 (CLIP) has fanout=1, link 30 (VAE) has fanout=0.
        # Therefore, no nodes should be optimized.
        
        set_nodes = [n for n in result.nodes.values() if n.type == "SetNode"]
        
        # No optimization expected for this data
        logger.info(f"✓ Mixed workflow: {original_count} -> {new_count} nodes, {len(set_nodes)} SetNodes")